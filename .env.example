# SafeAPI-Bridge Environment Template
# Copy to .env for local development only. Do not commit real secrets.

# Server
PORT=3000
NODE_ENV=development
LIGHT_MODE=false

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=replace-with-a-strong-random-jwt-secret

# Admin access for /admin/*, protected analytics, and /api-docs* endpoints.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_API_KEY=replace-with-a-strong-random-admin-key

# Database
# The current Prisma datasource is PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safeapi_bridge?schema=public

# CORS and mobile clients
# Use exact origins only. In production, remove localhost origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_MOBILE_NO_ORIGIN=true

# Global API rate limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=100

# Abuse guard for scanner probes and temporary IP blocks
ABUSE_GUARD_ENABLED=true
ABUSE_GUARD_STRIKE_THRESHOLD=5
ABUSE_GUARD_WINDOW_MS=600000
ABUSE_GUARD_BLOCK_MS=3600000
ABUSE_GUARD_BLOCK_AUTHENTICATED=false

# Logging and timeouts
LOG_DIR=./logs
LOG_LEVEL=info
LOG_MAX_FILES=30d
REQUEST_TIMEOUT_MS=90000
UPSTREAM_TIMEOUT_MS=60000

# Queue configuration (optional)
# Redis enables Bull queue support. Without Redis, the queue falls back to in-memory behavior.
# REDIS_URL=redis://localhost:6379
QUEUE_MAX_CONCURRENT=10
QUEUE_MAX_SIZE=1000
QUEUE_JOB_TIMEOUT_MS=120000

# Retry configuration
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_MS=1000
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RETRY_BACKOFF_MULTIPLIER=2

# Provider-specific optional rate limits (requests per minute)
RATE_LIMIT_OPENAI_MAX=500
RATE_LIMIT_GEMINI_MAX=60
RATE_LIMIT_CLAUDE_MAX=50
RATE_LIMIT_GROQ_MAX=100
RATE_LIMIT_DEFAULT_MAX=100

# Provider-specific optional timeouts
# OPENAI_TIMEOUT_MS=60000
# GEMINI_TIMEOUT_MS=60000
# CLAUDE_TIMEOUT_MS=90000
# GROQ_TIMEOUT_MS=30000

# AI provider keys and base URLs. Configure only the providers you use.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

GITHUB_MODELS_API_KEY=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

REPLICATE_API_KEY=
REPLICATE_BASE_URL=https://api.replicate.com/v1

STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai

FAL_API_KEY=
FAL_BASE_URL=https://fal.ai/api

ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

BRAVE_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com/res/v1

DEEPL_API_KEY=
DEEPL_BASE_URL=https://api-free.deepl.com/v2

# Open-Meteo does not require an API key by default.
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
