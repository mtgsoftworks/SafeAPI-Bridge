# ============================================
# SafeAPI-Bridge Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
# Set to 'true' for minimal resource usage (skips DB health checks)
LIGHT_MODE=false

# ============================================
# Security - JWT Configuration (REQUIRED)
# ============================================
# IMPORTANT: Change this in production!
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# Admin Configuration
# ============================================
# API key for admin endpoints (/admin/*, /analytics/overview, etc.)
ADMIN_API_KEY=your-admin-api-key-here

# ============================================
# Database Configuration
# ============================================
# SQLite (default for development)
DATABASE_URL=file:./dev.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/safeapi_bridge?schema=public

# ============================================
# AI Provider API Keys
# ============================================
# At least one API key is required for the proxy to work
# You can also use BYOK (Bring Your Own Key) split-key method

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic Claude
CLAUDE_API_KEY=sk-ant-your-claude-api-key
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# Groq
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mistral
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Z.ai (GLM)
ZAI_API_KEY=your-zai-api-key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Perplexity
PERPLEXITY_API_KEY=your-perplexity-api-key
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Together AI
TOGETHER_API_KEY=your-together-api-key
TOGETHER_BASE_URL=https://api.together.xyz/v1

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fireworks AI
FIREWORKS_API_KEY=your-fireworks-api-key
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# GitHub Models
GITHUB_MODELS_API_KEY=your-github-token
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Replicate
REPLICATE_API_KEY=your-replicate-api-key
REPLICATE_BASE_URL=https://api.replicate.com/v1

# Stability AI
STABILITY_API_KEY=your-stability-api-key
STABILITY_BASE_URL=https://api.stability.ai

# Fal.ai
FAL_API_KEY=your-fal-api-key
FAL_BASE_URL=https://fal.ai/api

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# Brave Search
BRAVE_API_KEY=your-brave-api-key
BRAVE_BASE_URL=https://api.search.brave.com/res/v1

# DeepL
DEEPL_API_KEY=your-deepl-api-key
DEEPL_BASE_URL=https://api-free.deepl.com/v2

# Open-Meteo (no API key required)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# ============================================
# Rate Limiting
# ============================================
# Window in milliseconds (default: 1 hour)
RATE_LIMIT_WINDOW_MS=3600000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Set to 'none' to disable CORS (not recommended)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Allow requests without Origin header (for mobile apps)
ALLOW_MOBILE_NO_ORIGIN=true

# ============================================
# Logging & Timeouts
# ============================================
LOG_DIR=./logs
REQUEST_TIMEOUT_MS=30000

# ============================================
# Queue Configuration (Optional)
# ============================================
# Redis URL for Bull queue (optional - falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# Queue settings
QUEUE_MAX_CONCURRENT=10
QUEUE_MAX_SIZE=1000
QUEUE_JOB_TIMEOUT_MS=120000

# ============================================
# Retry Configuration
# ============================================
# API request retry settings
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_MS=1000

# Queue retry settings
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY_MS=1000

# Maximum delay for exponential backoff
RETRY_MAX_DELAY_MS=30000
RETRY_BACKOFF_MULTIPLIER=2

# ============================================
# Upstream API Settings
# ============================================
# Override default timeout for upstream API calls
# UPSTREAM_TIMEOUT_MS=60000
